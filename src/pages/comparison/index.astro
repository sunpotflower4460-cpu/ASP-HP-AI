---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideNav from '../../components/GuideNav.astro';
import AffiliateCTA from '../../components/AffiliateCTA.astro';
import { getActiveOffers } from '../../lib/offers';
import type { Offer } from '../../lib/offers';
import decisionTags from '../../../data/decision-tags.json';

const activeOffers = getActiveOffers();
const filterTags = decisionTags.filter((tag) => tag.filter);
const filterIds = filterTags.map((tag) => tag.id);
const tagLabel = new Map(decisionTags.map((tag) => [tag.id, tag.label]));
const checkedAt = (offer: Offer) => {
  const dates = Object.values(offer.facts || {}).map((fact) => fact.checkedAt).filter(Boolean).sort();
  return dates.at(-1) || null;
};
---
<BaseLayout title="ネット環境を条件から比較する" description="賃貸・一人暮らしのネット環境を、工事可否・用途・居住期間・総額の条件から整理し、確認済みの提携サービスだけを比較します。">
  <article class="card">
    <h1>ネット環境を条件から比較する</h1>
    <p>ここでは「人気順」や根拠のないランキングではなく、<strong>自分の生活条件に合わない候補を先に外す</strong>方法で比較します。</p>
    <h2>比較する順番</h2>
    <ol>
      <li><strong>住居</strong>：固定回線の設備、工事可否、管理会社への確認。</li>
      <li><strong>用途</strong>：在宅勤務、ゲーム、動画など日常で負荷が高い使い方。</li>
      <li><strong>期間</strong>：長期か短期か、引っ越し予定があるか。</li>
      <li><strong>総額</strong>：開始・毎月・端末・終了時まで同じ利用期間で計算。</li>
      <li><strong>公式条件</strong>：最後は提供エリア・料金・契約条件を公式情報で確認。</li>
    </ol>
    <p><a href="/diagnosis/">まだ方向性が決まっていない場合は3問診断から →</a></p>
  </article>

  <section class="card">
    <h2>条件で候補を絞る</h2>
    <p>案件ごとに公式情報と照合して登録したタグだけを使います。タグが未確認の案件をAIが推測して分類することはありません。</p>
    <div class="filter-row" aria-label="比較条件">
      <button class="filter-chip" data-focus="all">すべて</button>
      {filterTags.map((tag) => <button class="filter-chip" data-focus={tag.id}>{tag.label}</button>)}
    </div>
    <p id="filter-status" class="muted" aria-live="polite"></p>
  </section>

  <section class="card">
    <h2>現在確認できる提携サービス</h2>
    <p>当サイトで事実情報・情報源・確認日・Web掲載可否を登録済みで、現在activeになっている案件だけを表示します。申込み前には必ず遷移先の公式情報で最新条件をご確認ください。</p>
    {activeOffers.length ? (
      <>
        <div class="offer-list" id="offer-list">
          {activeOffers.map((offer, index) => (
            <article class="offer-card" data-offer-card data-tags={(offer.decisionTags || []).join(',')}>
              <h3>{offer.name}</h3>
              {typeof offer.facts?.summary?.value === 'string' && <p>{offer.facts.summary.value}</p>}
              {(offer.decisionTags || []).length > 0 && (
                <p class="tag-list" aria-label="確認済み条件">{offer.decisionTags!.map((tag) => <span class="tag">{tagLabel.get(tag) || tag}</span>)}</p>
              )}
              {checkedAt(offer) && <p class="muted">情報確認日: {checkedAt(offer)}</p>}
              <AffiliateCTA offerId={offer.id} pageId="p010" ctaId="compare_list" positionId={`pos${String(index + 1).padStart(2,'0')}`} label="公式サイトで条件を確認" />
            </article>
          ))}
        </div>
        <div id="filter-empty" class="notice" hidden>
          <p><strong>この条件に一致する確認済み案件は、現在まだ登録されていません。</strong></p>
          <p>無理に別条件の案件をおすすめせず、確認済み候補がある条件だけ表示しています。</p>
          <button class="filter-chip" id="show-all-offers" type="button">条件を解除してすべて見る</button>
        </div>
      </>
    ) : (
      <p>現在は公開準備中です。案件をactiveにすると、確認済みサービスがここへ自動表示されます。</p>
    )}
  </section>
  <GuideNav />

  <script is:inline define:vars={{ filterIds }}>
    const allowed = new Set(['all', ...filterIds]);
    const params = new URLSearchParams(location.search);
    let focus = allowed.has(params.get('focus')) ? params.get('focus') : 'all';
    const cards = [...document.querySelectorAll('[data-offer-card]')];
    const buttons = [...document.querySelectorAll('[data-focus]')];
    const status = document.querySelector('#filter-status');
    const empty = document.querySelector('#filter-empty');
    const showAll = document.querySelector('#show-all-offers');
    function applyFilter(nextFocus) {
      focus = allowed.has(nextFocus) ? nextFocus : 'all';
      let visible = 0;
      for (const card of cards) {
        const tags = new Set((card.dataset.tags || '').split(',').filter(Boolean));
        const show = focus === 'all' || tags.has(focus);
        card.hidden = !show;
        if (show) visible++;
      }
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.focus === focus));
      if (status) status.textContent = cards.length ? `${visible}件の確認済み候補を表示しています。` : '';
      if (empty) empty.hidden = visible > 0 || cards.length === 0;
      const url = new URL(location.href);
      if (focus === 'all') url.searchParams.delete('focus'); else url.searchParams.set('focus', focus);
      history.replaceState(null, '', url);
    }
    for (const button of buttons) button.addEventListener('click', () => applyFilter(button.dataset.focus));
    if (showAll) showAll.addEventListener('click', () => applyFilter('all'));
    applyFilter(focus);
  </script>
</BaseLayout>
