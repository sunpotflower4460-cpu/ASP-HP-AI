# Local autonomous loop. Copy to .env.local and keep that file uncommitted.
LOCAL_AUTOMATION_ENABLED=false
LOCAL_AUTO_PUSH=false
LOCAL_AUTOMATION_BRANCH=main
LOCAL_SCHEDULE_HOUR=7
LOCAL_SCHEDULE_MINUTE=20
# Prevent overlapping manual/launchd runs. A lock older than this is treated as stale.
LOCAL_RUN_LOCK_MAX_AGE_HOURS=6

# Optional private operational-data backup.
# IMPORTANT: must point OUTSIDE this public Git repository.
# Example: LOCAL_BACKUP_DIR=/Users/you/Documents/ASP-HP-AI-private-backups
LOCAL_BACKUP_DIR=
LOCAL_BACKUP_RETENTION_DAYS=30
# true = daily automation blocks public-content commit when backup/integrity verification fails.
LOCAL_BACKUP_REQUIRED=false

# Optional: drop an A8 report CSV at this path and the next run imports it automatically.
# Example: A8_AUTO_IMPORT_FILE=imports/a8-report.csv
A8_AUTO_IMPORT_FILE=
A8_CSV_ENCODING=shift_jis

# Public site mode
SITE_URL=https://example.com
PUBLIC_READY=false
PRODUCTION_BRANCH=main

# Optional post-deploy remote verification. Empty REMOTE_SITE_URL falls back to SITE_URL.
REMOTE_SITE_URL=
REMOTE_EXPECT_PUBLIC=true
REMOTE_REQUIRE_COMMIT_MATCH=false
REMOTE_SMOKE_TIMEOUT_MS=10000
# When LOCAL_AUTO_PUSH=true, optionally wait until Cloudflare serves that exact commit.
REMOTE_SMOKE_AFTER_PUSH=false
REMOTE_SMOKE_RETRIES=6
REMOTE_SMOKE_RETRY_DELAY_MS=20000

# Optional GA4 browser tracking. Empty = Google tag is not emitted.
PUBLIC_GA_MEASUREMENT_ID=
# Optional GA4 Data API. Numeric property ID (not G-XXXXXXXXXX).
GA_PROPERTY_ID=
# Leave these empty to reuse GSC_CLIENT_EMAIL / GSC_PRIVATE_KEY.
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
GA_FETCH_REQUIRED=false
GA_DATA_MAX_AGE_HOURS=72

# Search Console
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=
GSC_DATA_MAX_AGE_HOURS=72
# Search Analytics rowLimit is 25,000. This caps pages requested per fetch cycle.
# Google can still omit some query/page rows because of Search Console internal limits.
GSC_MAX_PAGES=4

# ValueCommerce (optional)
VALUECOMMERCE_CLIENT_KEY=
VALUECOMMERCE_CLIENT_SECRET=
VALUECOMMERCE_LOOKBACK_DAYS=30

# AI editor (optional)
AI_EDITOR_ENABLED=false
EDITOR_AUTO_APPLY_TITLE=false
ALLOW_PAID_AI=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
