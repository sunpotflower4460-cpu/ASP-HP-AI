# Local autonomous loop. Copy to .env.local and keep that file uncommitted.
LOCAL_AUTOMATION_ENABLED=false
LOCAL_AUTO_PUSH=false
LOCAL_AUTOMATION_BRANCH=main
LOCAL_SCHEDULE_HOUR=7
LOCAL_SCHEDULE_MINUTE=20

# Optional: drop an A8 report CSV at this path and the next run imports it automatically.
# Example: A8_AUTO_IMPORT_FILE=imports/a8-report.csv
A8_AUTO_IMPORT_FILE=
A8_CSV_ENCODING=shift_jis

# Public site mode
SITE_URL=https://example.com
PUBLIC_READY=false

# Optional GA4 browser tracking. Empty = Google tag is not emitted.
PUBLIC_GA_MEASUREMENT_ID=
# Optional GA4 Data API. Numeric property ID (not G-XXXXXXXXXX).
GA_PROPERTY_ID=
# Leave these empty to reuse GSC_CLIENT_EMAIL / GSC_PRIVATE_KEY.
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
GA_FETCH_REQUIRED=false
GA_DATA_MAX_AGE_HOURS=72

# Search Console
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=
GSC_DATA_MAX_AGE_HOURS=72

# ValueCommerce (optional)
VALUECOMMERCE_CLIENT_KEY=
VALUECOMMERCE_CLIENT_SECRET=
VALUECOMMERCE_LOOKBACK_DAYS=30

# AI editor (optional)
AI_EDITOR_ENABLED=false
EDITOR_AUTO_APPLY_TITLE=false
ALLOW_PAID_AI=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
